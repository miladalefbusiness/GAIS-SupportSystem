# ==============================================================================
# Organizational AI Support Desk & File Hub — Environment Configuration
# ==============================================================================
# Never commit a populated .env file with real secrets to version control.

# Application & Release Pinning (NEVER use 'latest' in production)
NODE_ENV="production"
APP_URL="https://support.example.com"
APP_VERSION="0.1.0"
APP_IMAGE="ghcr.io/your-org/supportdesk"
RELEASE_BASE_URL="https://github.com/your-org/supportdesk/releases/download"
DOMAIN_NAME="support.example.com"
ACME_EMAIL="admin@support.example.com"
TZ="Asia/Tehran"
PORT="3000"

# Database Mode: bundled | external
DB_MODE="bundled"

# PostgreSQL Connection (pgvector + pg_trgm required)
SQL_HOST="postgres"
SQL_PORT="5432"
SQL_DB_NAME="supportdesk"
SQL_USER="supportdesk_app"
SQL_PASSWORD="CHANGE_ME_APP_DB_PASSWORD"
SQL_ADMIN_USER="supportdesk_admin"
SQL_ADMIN_PASSWORD="CHANGE_ME_ADMIN_DB_PASSWORD"

# Bundled PostgreSQL Container Superuser Credentials (used when DB_MODE=bundled)
POSTGRES_DB="supportdesk"
POSTGRES_USER="supportdesk_admin"
POSTGRES_PASSWORD="CHANGE_ME_ADMIN_DB_PASSWORD"

# Cryptographic Secrets (generate each with: openssl rand -hex 32)
BETTER_AUTH_SECRET="CHANGE_ME_GENERATE_AT_LEAST_32_CHARS_RANDOM_HEX"
APP_ENCRYPTION_KEY="CHANGE_ME_64_HEX_CHARS_FOR_AES_256_GCM"
APP_HMAC_KEY="CHANGE_ME_64_HEX_CHARS_FOR_HMAC_SHA256"

# Initial Super Admin Bootstrap (used ONLY once on an uninitialized database)
SUPERADMIN_USERNAME="superadmin"
SUPERADMIN_EMAIL="admin@support.example.com"
SUPERADMIN_PASSWORD="CHANGE_ME_INITIAL_BOOTSTRAP_PASSWORD"
SUPERADMIN_NAME="مدیر ارشد سامانه"

# Persistent File Storage (must point outside the web root)
STORAGE_DRIVER="local"
STORAGE_ROOT="/var/lib/supportdesk/storage"
STORAGE_MAX_BYTES="10737418240"
MAX_UPLOAD_MB="25"

# Backup & Retention
BACKUP_RETENTION_COUNT="14"

# Background Worker (RAG Document Ingestion)
WORKER_POLL_INTERVAL_MS="3000"

# Optional AI Provider Bootstrap (can also be configured later in Super Admin UI)
AI_BASE_URL=""
AI_API_KEY=""
AI_CHAT_MODEL=""
AI_EMBEDDING_MODEL=""
GEMINI_API_KEY=""

# Optional SMS / OTP Verification Integration
# OTP_PROVIDER: disabled | sms_webhook | dev_mock (dev_mock blocked in production)
OTP_PROVIDER="disabled"
OTP_SMS_WEBHOOK_URL=""
OTP_SMS_API_KEY=""

# Optional Email / SMTP Settings
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Optional S3-Compatible Object Storage (when STORAGE_DRIVER=s3)
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Optional ClamAV Attachment Scanner
AV_SCANNER_MODE="disabled"
CLAMAV_HOST="127.0.0.1"
CLAMAV_PORT="3310"
