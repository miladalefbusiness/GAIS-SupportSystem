# ==============================================================================
# Organizational AI Support Desk & File Hub — Environment Configuration
# ==============================================================================
# Never commit a populated .env file with real secrets to version control.

# Application
NODE_ENV="development"
APP_URL="http://localhost:3000"
APP_VERSION="0.1.0"
PORT="3000"

# PostgreSQL Connection (Object Method — compatible with Cloud SQL & Docker Compose)
SQL_HOST="localhost"
SQL_PORT="5432"
SQL_DB_NAME="supportdesk"
SQL_USER="supportdesk_app"
SQL_PASSWORD="CHANGE_ME_APP_DB_PASSWORD"
SQL_ADMIN_USER="supportdesk_admin"
SQL_ADMIN_PASSWORD="CHANGE_ME_ADMIN_DB_PASSWORD"

# Authentication & Security Secrets (generate with: openssl rand -hex 32)
BETTER_AUTH_SECRET="CHANGE_ME_GENERATE_AT_LEAST_32_CHARS_RANDOM_HEX"
APP_ENCRYPTION_KEY="CHANGE_ME_64_HEX_CHARS_FOR_AES_256_GCM"
APP_HMAC_KEY="CHANGE_ME_64_HEX_CHARS_FOR_HMAC_SHA256"

# Initial Super Admin Bootstrap (used ONLY once on an uninitialized database)
SUPERADMIN_USERNAME="superadmin"
SUPERADMIN_EMAIL="admin@support.example.com"
SUPERADMIN_PASSWORD="CHANGE_ME_INITIAL_BOOTSTRAP_PASSWORD"
SUPERADMIN_NAME="مدیر ارشد سامانه"

# Persistent File Storage (must point outside the web root)
STORAGE_DRIVER="local"
STORAGE_ROOT="./data/storage"
STORAGE_MAX_BYTES="10737418240"

# Docker Compose / Registry Configuration (for self-hosted deployment)
APP_IMAGE="ghcr.io/your-org/supportdesk"
DOMAIN_NAME="support.example.com"
POSTGRES_DB="supportdesk"
POSTGRES_USER="supportdesk_admin"
POSTGRES_PASSWORD="CHANGE_ME_ADMIN_DB_PASSWORD"

# Optional Gemini / AI Provider Bootstrap (configured in Phase 3)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Customer OTP Verification & Attachment Scanner (Phase 4)
# OTP_PROVIDER: dev_mock (development/testing only) | sms_webhook | disabled
OTP_PROVIDER="dev_mock"
OTP_SMS_WEBHOOK_URL=""
OTP_SMS_API_KEY=""
# AV_SCANNER_MODE: disabled | clamav
AV_SCANNER_MODE="disabled"
CLAMAV_HOST="127.0.0.1"
CLAMAV_PORT="3310"

